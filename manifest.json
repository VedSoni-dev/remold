{
  "manifest_version": 3,
  "name": "Remold",
  "short_name": "Remold",
  "version": "0.2.0",
  "description": "Describe how any website should look or behave, and it changes. Mix a tab group into one tab. Free and open source.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Remold this site" },
  "side_panel": { "default_path": "src/panel.html" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "tabs", "tabGroups", "scripting", "alarms", "declarativeNetRequest", "contextMenus"],
  "optional_permissions": ["userScripts"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": false
  }],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" } }
  }
}
